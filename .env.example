# Recommended DeepSeek profile
DEEPSEEK_API_KEY=your-deepseek-api-key

# Optional runtime overrides for profiles saved by `laohuang config`
# LAOHUANG_PROFILE=default
# LAOHUANG_MODEL=deepseek-v4-flash
# LAOHUANG_BASE_URL=https://api.deepseek.com
# LAOHUANG_CONFIG=/custom/path/config.json

# Legacy OpenAI-compatible configuration (works without a config file)
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=your-model-name
OPENAI_BASE_URL=https://api.openai.com/v1
