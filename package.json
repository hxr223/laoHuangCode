{
  "name": "laohuang",
  "version": "0.4.2",
  "description": "A minimal coding agent CLI built on the official openai SDK and Chat Completions native tool calling.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hxr223/laoHuangCode"
  },
  "homepage": "https://github.com/hxr223/laoHuangCode#readme",
  "bugs": "https://github.com/hxr223/laoHuangCode/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "laohuang": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test \"scripts/**/*.test.ts\"",
    "check:version": "node scripts/check-package-version.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:tui": "bash scripts/tui-smoke.sh",
    "verify:published": "node scripts/verify-published-version.mjs",
    "stats:test": "node scripts/test-stats.mjs",
    "profile:cli": "node scripts/profile-cli.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
