{
  "name": "@laohuang/workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b && npm run bundle --workspace laohuang",
    "build:standalone": "node scripts/build-standalone.mjs",
    "smoke:standalone": "node scripts/standalone-smoke.mjs",
    "test": "node --test \"scripts/**/*.test.ts\"",
    "test:e2e:pi-ai": "LAOHUANG_RUN_PROVIDER_E2E=1 node --test scripts/pi-ai-provider.e2e.test.ts",
    "check:version": "node scripts/check-package-version.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:tui": "bash scripts/tui-smoke.sh && node scripts/tui-offline-terminal-transcript-smoke.ts",
    "verify:published": "node scripts/verify-published-version.mjs",
    "stats:test": "node scripts/test-stats.mjs",
    "profile:cli": "node scripts/profile-cli.mjs",
    "eval:prepare": "npm run build && node scripts/evals/cli.ts prepare",
    "eval:check": "tsc -p scripts/evals/tsconfig.json && node --test scripts/eval-*.test.ts",
    "eval:offline": "LAOHUANG_EVAL_DOCKER_TESTS=1 node --test scripts/eval-sandbox.test.ts",
    "eval:all": "node scripts/evals/cli.ts run",
    "eval:config": "node scripts/evals/cli.ts config",
    "eval:web": "promptfoo view -p 15500",
    "prepack": "npm run build",
    "eval:generate": "node scripts/evals/cli.ts generate",
    "eval:tui": "npm run smoke:tui"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@xterm/headless": "5.5.0",
    "esbuild": "^0.28.2",
    "promptfoo": "0.122.2",
    "typescript": "^5.5.0"
  }
}
